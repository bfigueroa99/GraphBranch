{
  "manifest_version": 3,
  "name": "GraphBranch",
  "version": "0.1.0",
  "description": "Botón «Abrir en GraphBranch» en las páginas de un repo de GitHub: abre el grafo de ramas en vivo de ese repo.",
  "icons": { "192": "icons/icon-192.png", "512": "icons/icon-512.png" },
  "content_scripts": [
    {
      "matches": ["https://github.com/*"],
      "js": ["repo.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": { "gecko": { "id": "graphbranch@bfigueroa99.github.io", "strict_min_version": "109.0" } }
}
