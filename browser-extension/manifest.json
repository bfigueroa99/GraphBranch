{
  "manifest_version": 3,
  "name": "GraphBranch",
  "version": "0.1.0",
  "description": "__MSG_description__",
  "default_locale": "en",
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "content_scripts": [
    {
      "matches": ["https://github.com/*", "https://gitlab.com/*", "https://codeberg.org/*", "https://bitbucket.org/*"],
      "js": ["repo.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": { "gecko": { "id": "graphbranch@bfigueroa99.github.io", "strict_min_version": "109.0" } }
}
